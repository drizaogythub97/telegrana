# =====================================================================
# Telegrana — modelo do .env.local
# =====================================================================
# Como usar:
#   1. Copie este arquivo para ".env.local" (na raiz do projeto):
#        PowerShell:  Copy-Item .env.local.example .env.local
#   2. Preencha as variáveis conforme for concluindo cada micro-fase da S0
#      (guias em docs/manual/). Deixe em branco o que ainda não fez.
#   3. Rode:  python scripts/check_setup.py
#
# Regras:
#   - O .env.local está no .gitignore. NUNCA commite, cole no chat,
#     mande por mensagem nem tire print dele.
#   - Formato: NOME=valor  (sem espaços ao redor do "=", sem aspas).
#   - Linhas começando com "#" são comentários.
#   - Os segredos de produção vão para o SSM Parameter Store na S1
#     (o agente faz isso); o .env.local é só para a máquina local.
# =====================================================================


# ---------------------------------------------------------------------
# S0.1 — GitHub  (docs/manual/S0.1-github.md)
# ---------------------------------------------------------------------
# Repositório no formato dono/nome. Não é segredo.
# Ex.: GITHUB_REPO=drizaogythub97/telegrana
GITHUB_REPO=


# ---------------------------------------------------------------------
# S0.2 — AWS  (docs/manual/S0.2-aws.md)
# ---------------------------------------------------------------------
# Nenhuma chave de acesso aqui: o login é temporário, via "aws login".
# Nome do perfil do AWS CLI criado no guia. Não é segredo.
AWS_PROFILE=telegrana
# Região do projeto (fixa).
AWS_REGION=us-east-1
# Opcional. Endereço de login do console do usuário IAM (passo 6 do guia).
# Não é segredo, mas contém o número da conta: fica só aqui.
AWS_CONSOLE_SIGNIN_URL=


# ---------------------------------------------------------------------
# S0.3 — Neon Postgres  (docs/manual/S0.3-neon.md)
# ---------------------------------------------------------------------
# SEGREDO. Strings de conexão DIRETAS (sem "-pooler" no host) do papel dono
# (neondb_owner). O agente as usa só para criar os papéis "migrator" e "app"
# e aplicar migrações. Formato:
#   postgresql://neondb_owner:SENHA@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Branch "production" (produção):
NEON_OWNER_URL_PROD=
# Branch "dev" (desenvolvimento e testes manuais):
NEON_OWNER_URL_DEV=

# Preenchidas pelo AGENTE na S1 (não preencha):
# NEON_APP_URL_DEV=
# NEON_MIGRATOR_URL_DEV=


# ---------------------------------------------------------------------
# S0.4 — Groq  (docs/manual/S0.4-groq.md)
# ---------------------------------------------------------------------
# SEGREDO. Chaves de API (começam com "gsk_").
GROQ_API_KEY_PROD=
GROQ_API_KEY_DEV=


# ---------------------------------------------------------------------
# S0.5 — Telegram  (docs/manual/S0.5-telegram.md)
# ---------------------------------------------------------------------
# SEGREDO. Token do bot de produção (formato 123456789:AAxxxx...).
TELEGRAM_BOT_TOKEN_PROD=
# @ do bot de produção, sem o "@". Não é segredo. Ex.: TelegranaBot
TELEGRAM_BOT_USERNAME_PROD=

# SEGREDO. Token do bot de desenvolvimento.
TELEGRAM_BOT_TOKEN_DEV=
# @ do bot de desenvolvimento, sem o "@". Ex.: TelegranaDevBot
TELEGRAM_BOT_USERNAME_DEV=

# api_id e api_hash de my.telegram.org (usados SÓ nos testes automáticos,
# no servidor de TESTES do Telegram). api_id é um número; api_hash é SEGREDO
# (32 caracteres hexadecimais).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Seu id numérico do Telegram (o admin do bot). Não é segredo, mas não
# precisa ficar público. Descubra com:
#   python scripts/check_setup.py --descobrir-admin-id
ADMIN_TELEGRAM_ID=

# Preenchido pelo AGENTE na S1 (bot criado no servidor de testes):
# TELEGRAM_BOT_TOKEN_TEST=


# ---------------------------------------------------------------------
# S0.6 — Celular Android  (docs/manual/S0.6-android.md)
# ---------------------------------------------------------------------
# Opcional. Endereço IP:PORTA da depuração sem fio, se houver mais de um
# aparelho conectado. A porta muda a cada vez que a depuração é religada.
ADB_DEVICE=


# ---------------------------------------------------------------------
# Gerados pelo AGENTE na S1 e guardados no SSM (não preencha):
# ---------------------------------------------------------------------
# TELEGRAM_WEBHOOK_SECRET   — cabeçalho X-Telegram-Bot-Api-Secret-Token
# PHONE_HMAC_PEPPER         — chave do HMAC-SHA256 do telefone
# TELEGRAPH_ACCESS_TOKEN    — conta do projeto no Telegraph (termos/política)
